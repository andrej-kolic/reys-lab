---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ListRow from "../components/ListRow.astro";
import { site, formatDate } from "../lib/site";

// Who / what / proof / contact, in roughly one and a half screens. A recruiter
// gives it seconds, so the positioning line has to land without scrolling.

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<SiteLayout
  title={site.name}
  bare
  description={`Portfolio and lab notes by ${site.author}.`}
>
  {/*
    The hero signature — experiment 02 — is still open, so the name ships in
    flat ink for now. Whatever wins is one rule on this one element.
  */}
  <section class="pb-20">
    <p class="label !text-accent">{site.positioning}</p>
    <h1
      class="mt-4 font-display text-6xl leading-[1.02] font-bold tracking-tight text-balance sm:text-7xl"
    >
      Rey&rsquo;s Lab
    </h1>
    <p class="mt-6 max-w-measure text-lg leading-relaxed text-muted text-pretty">
      I build things and write down what they cost. Projects here come with the
      tradeoff attached, not just a screenshot — and the site itself is kept in
      the open, decision by dated decision, in the lab.
    </p>
    <div class="mt-8 flex flex-wrap gap-x-5 gap-y-3">
      {/*
        Experiment 03's candidate J, settled 2026-09-21. Both treatments live
        in global.css — including the matching 1px border that keeps the two
        the same height once they wrap onto separate lines, which is on a
        phone.

        The rule J established: among controls, only the primary carries a
        background. The secondary is a ring and never fills, in any state,
        because a filled secondary is a second primary.
      */}
      <a href="/projects" class="btn-primary">See the work</a>
      <a href={`mailto:${site.email}`} class="btn-secondary">Get in touch</a>
    </div>
  </section>

  <section>
    <div class="mb-6 flex flex-wrap items-baseline gap-x-5">
      <h2 class="font-display text-2xl font-semibold tracking-tight">
        Selected projects
      </h2>
      <a
        href="/projects"
        class="label ml-auto transition-colors duration-150 hover:!text-label-hover"
      >
        All projects
      </a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => (
          <ProjectCard
            href={`/projects/${project.id}`}
            title={project.data.title}
            description={project.data.description}
            stack={project.data.stack}
            status={project.data.status}
          />
        ))
      }
    </div>
  </section>

  <section class="mt-20">
    <div class="mb-6 flex flex-wrap items-baseline gap-x-5">
      <h2 class="font-display text-2xl font-semibold tracking-tight">
        Recent posts
      </h2>
      <a
        href="/blog"
        class="label ml-auto transition-colors duration-150 hover:!text-label-hover"
      >
        All posts
      </a>
    </div>
    <div class="rounded-xl border border-border bg-surface">
      {
        posts.map((post) => (
          <ListRow
            href={`/blog/${post.id}`}
            meta={formatDate(post.data.date)}
            datetime={formatDate(post.data.date)}
            title={post.data.title}
            description={post.data.description}
          />
        ))
      }
    </div>
  </section>
</SiteLayout>
