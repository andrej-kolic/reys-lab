---
interface Props {
  id: string;
  title: string;
  note?: string;
}

const { id, title, note } = Astro.props;
---

<section id={id} class="mb-20 scroll-mt-24">
  <div class="mb-7 border-b border-border/60 pb-3">
    <h2 class="font-display text-2xl font-semibold tracking-tight">
      <a href={`#${id}`} class="transition-colors duration-150 hover:text-accent"
        >{title}</a
      >
    </h2>
    {note && <p class="mt-2 max-w-measure text-sm text-muted">{note}</p>}
  </div>
  <slot />
</section>
