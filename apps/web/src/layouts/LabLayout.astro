---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import SubNav from "../components/SubNav.astro";
import { bySlug, owner } from "../lib/experiments";
import { site } from "../lib/site";

interface Props {
  title: string;
  /**
   * Mono eyebrow above the page heading. Ignored for kind="experiment", whose
   * eyebrow is its status and date, read from the registry.
   */
  eyebrow?: string;
  intro: string;
  /**
   * Which half of the lab this page is.
   *
   * The split is not topic, it is whether the page is allowed to change:
   *
   *   experiment — frozen once dated. A record. Public and indexed, because
   *                showing how a decision got made is the strongest evidence
   *                on the site.
   *   reference  — maintained, always reflects the site as it is now.
   *                noindex: it is a tool, a wall of swatches with no
   *                narrative, and the story worth reading is told in the
   *                experiment that produced it.
   *   index      — the lab index itself.
   */
  kind: "index" | "experiment" | "reference";
  /**
   * Required for kind="experiment": the registry slug. The owner, status and
   * date are read from there rather than retyped here, so a page cannot
   * disagree with the lab index about which project it belongs to.
   */
  slug?: string;
}

const { title, eyebrow, intro, kind, slug } = Astro.props;

const experiment = slug ? bySlug(slug) : undefined;
const project = experiment ? owner(experiment) : undefined;

// An experiment's breadcrumb names it by number, which nothing else on the
// page shows. A reference page is named by its title, like a blog post or a
// project: "Reference" alone did not say which of the four you were on.
const current = experiment ? `Experiment ${experiment.number}` : title;
const label = experiment
  ? experiment.status === "settled"
    ? `Settled ${experiment.date}`
    : `Open since ${experiment.date}`
  : eyebrow;
---

<BaseLayout
  title={`${title} · ${site.name}`}
  noindex={kind === "reference"}
>
  <div class="page-glow flex min-h-screen flex-col">
    <SiteHeader>
      <SubNav>
        {
          // Left is where you are, right is where you can go on this page. /lab
          // has no parent to show, so its left side stays empty.
          kind === "index" ? (
            <nav class="label ml-auto flex flex-wrap gap-x-6 gap-y-2" aria-label="On this page">
              <a href="#experiments" class="transition-colors duration-150 hover:!text-accent">
                Experiments
              </a>
              <a href="#reference" class="transition-colors duration-150 hover:!text-accent">
                Reference
              </a>
            </nav>
          ) : (
            <Breadcrumb
              trail={[{ href: "/lab", label: "Lab" }]}
              current={current}
            />
          )
        }
      </SubNav>
    </SiteHeader>

    <div class="mx-auto w-full max-w-5xl grow px-5 pb-20">
      {/*
        No line under the intro. The first section is almost always a box, whose
        own edge separates it; a line here drew a second one.
      */}
      <header class="pt-12">
        {label && <p class="label !text-accent">{label}</p>}
        <h1
          class:list={[
            "font-display text-5xl leading-[1.05] font-bold tracking-tight text-balance sm:text-6xl",
            label && "mt-3",
          ]}
        >
          {title}
        </h1>
        <p
          class="mt-5 max-w-measure text-lg leading-relaxed text-muted text-pretty"
        >
          {intro}
        </p>

        {
          // The project as the same tag the /lab row shows. A tag is never a
          // link, so a project with its own page gets a separate link beside
          // it. Chosen in #14 over the project joined to the eyebrow.
          project && (
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <span class="label">Run for</span>
              <span class="tag">{project.name}</span>
              {project.href && (
                <a
                  href={project.href}
                  class="label transition-colors duration-150 hover:!text-accent"
                >
                  Project →
                </a>
              )}
            </div>
          )
        }
      </header>

      {/*
        No closing line stating the page's contract. It was written for the
        maintainer, not the reader, and on an open experiment "frozen once
        dated" read as if the page were already settled. The eyebrow carries
        status and date, which is the part a reader needs.
      */}
      <main class="pt-14">
        <slot />
      </main>
    </div>

    <SiteFooter />
  </div>
</BaseLayout>
