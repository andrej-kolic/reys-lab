---
/**
 * The lab's instrument bar.
 *
 * It was a candidate switcher — theme, shade and glow, persisted to
 * localStorage. All three are settled now (violet c, folded shades, glow .28),
 * so there is nothing left to switch and the controls are gone. What remains is
 * the readout, which reports the settled values instead of claiming them: the
 * palette name and both accent names are read back out of the live cascade, so
 * this line cannot disagree with global.css.
 *
 * The candidates themselves are not lost, they are quarantined — see
 * /lab/experiments/01-choosing-a-palette.
 */
---

<div
  class="sticky top-0 z-50 border-b border-border/70 bg-bg/85 backdrop-blur-md"
  data-lab-controls
>
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-5 py-3"
  >
    <a
      href="/lab"
      class="label !text-accent transition-opacity duration-150 hover:opacity-70"
      >Rey&rsquo;s Lab</a
    >

    <output
      class="label ml-auto !normal-case !tracking-normal !text-muted"
      data-lab-readout>&mdash;</output
    >
  </div>
</div>

<script>
  const styles = getComputedStyle(document.documentElement);
  const value = (name: string) =>
    styles.getPropertyValue(name).trim().replace(/"/g, "");

  const node = document.querySelector("[data-lab-readout]");
  if (node) {
    // Each accent names itself in the token layer, so the pair is reported
    // rather than hardcoded — the same reason the palette names itself.
    const accents = [1, 2]
      .map((n) => value(`--lab-accent-${n}-name`))
      .filter(Boolean)
      .join(" + ");

    node.textContent = [
      value("--lab-theme-name"),
      "Outfit",
      accents,
      `glow ${value("--glow-strength")}`,
    ]
      .filter(Boolean)
      .join(" \u00b7 ");
  }
</script>
