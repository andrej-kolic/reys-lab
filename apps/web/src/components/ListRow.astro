---
/**
 * The one-line row. Carries both the blog index and the lab index, because
 * they are the two lists that actually grow — the row is what lets them reach
 * fifty entries without pagination or a fourth navigation level.
 *
 * The left column is the mono meta: a date on a post, an experiment number in
 * the lab. `tag` is the optional trailing marker — a status on an experiment,
 * nothing on a post.
 */

interface Props {
  href: string;
  /** Mono, left column. A date, or `EXPERIMENT 02`. */
  meta: string;
  /** Set when `meta` is a date, so the row emits a real <time>. */
  datetime?: string;
  /**
   * Second line under `meta`: the experiment's project, as a tag — the same
   * tag the experiment page shows. Never a link: the whole row already is one.
   */
  metaSub?: string;
  title: string;
  description: string;
  tag?: string;
  /** Second line under `tag`, set like `metaSub`. A settled experiment's date. */
  tagSub?: string;
  /** Warm marks state — `OPEN`. Cool is for interaction only, never this. */
  tagTone?: "warm" | "dim";
}

const {
  href,
  meta,
  datetime,
  metaSub,
  title,
  description,
  tag,
  tagSub,
  tagTone = "dim",
} = Astro.props;

const Meta = datetime ? "time" : "span";
---

<a
  href={href}
  class="group flex flex-col gap-1 border-b border-border/60 px-6 py-5 transition-colors duration-150 last:border-b-0 hover:bg-raised/40 sm:flex-row sm:items-baseline sm:gap-6"
>
  <div class="w-32 shrink-0">
    {/*
      With a second line, the two must not read as one: the first is brighter
      and keeps the capitals, the second is a tag.
    */}
    <Meta
      datetime={datetime}
      class:list={["label tabular-nums", metaSub && "!text-muted"]}
      >{meta}</Meta
    >
    {metaSub && <p class="mt-1.5"><span class="tag">{metaSub}</span></p>}
  </div>
  <div class="min-w-0 grow">
    <h3
      class="font-display text-lg font-semibold tracking-tight transition-colors duration-150 group-hover:text-accent"
    >
      {title}
    </h3>
    <p class="mt-1 text-sm leading-relaxed text-muted">{description}</p>
  </div>
  {
    // Fixed width, so a long status does not narrow one row's description
    // and not the next. It mirrors the left column: capitals, then plain.
    tag && (
      <div class="w-28 shrink-0 sm:text-right">
        <span
          class:list={["label", tagTone === "warm" ? "!text-warm" : ""]}
        >
          {tag}
        </span>
        {tagSub && (
          <p class="mt-1 text-xs text-dim tabular-nums">{tagSub}</p>
        )}
      </div>
    )
  }
</a>
