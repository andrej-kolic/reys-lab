---
import BaseLayout from "./BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import SubNav from "../components/SubNav.astro";
import { bySlug, owner } from "../lib/experiments";
import { site } from "../lib/site";

interface Props {
  title: string;
  /**
   * Mono eyebrow above the page heading. Ignored for kind="experiment", whose
   * eyebrow is its status and date, read from the registry.
   */
  eyebrow?: string;
  intro: string;
  /**
   * Which half of the lab this page is.
   *
   * The split is not topic, it is whether the page is allowed to change:
   *
   *   experiment — frozen once dated. A record. Public and indexed, because
   *                showing how a decision got made is the strongest evidence
   *                on the site.
   *   reference  — maintained, always reflects the site as it is now.
   *                noindex: it is a tool, a wall of swatches with no
   *                narrative, and the story worth reading is told in the
   *                experiment that produced it.
   *   index      — the lab index itself.
   */
  kind: "index" | "experiment" | "reference";
  /**
   * Required for kind="experiment": the registry slug. The owner, status and
   * date are read from there rather than retyped here, so a page cannot
   * disagree with the lab index about which project it belongs to.
   */
  slug?: string;
}

const { title, eyebrow, intro, kind, slug } = Astro.props;

const experiment = slug ? bySlug(slug) : undefined;
const project = experiment ? owner(experiment) : undefined;

// The breadcrumb names what kind of page this is and the eyebrow says more
// about it, so neither repeats the h1 below them. Reference is not a page of
// its own, so it is the unlinked last segment rather than a link in the trail.
const current = experiment
  ? `Experiment ${experiment.number}`
  : kind === "reference"
    ? "Reference"
    : title;
const label = experiment
  ? experiment.status === "settled"
    ? `Settled ${experiment.date}`
    : `Open since ${experiment.date}`
  : eyebrow;
---

<BaseLayout
  title={`${title} · ${site.name}`}
  noindex={kind === "reference"}
>
  <div class="page-glow flex min-h-screen flex-col">
    <SiteNav />
    <SubNav>
      {
        kind === "index" ? (
          <nav class="label flex flex-wrap gap-x-6 gap-y-2" aria-label="On this page">
            <a href="#experiments" class="transition-colors duration-150 hover:!text-accent">
              Experiments
            </a>
            <a href="#reference" class="transition-colors duration-150 hover:!text-accent">
              Reference
            </a>
          </nav>
        ) : (
          <Breadcrumb
            trail={[{ href: "/lab", label: "Lab" }]}
            current={current}
          />
        )
      }
    </SubNav>

    <div class="mx-auto w-full max-w-5xl grow px-5 pb-20">
      <header
        class:list={[
          "pt-12",
          // /lab's first section draws its own line right below.
          kind !== "index" && "border-b border-border pb-12",
        ]}
      >
        {label && <p class="label !text-accent">{label}</p>}
        <h1
          class:list={[
            "font-display text-5xl leading-[1.05] font-bold tracking-tight text-balance sm:text-6xl",
            label && "mt-3",
          ]}
        >
          {title}
        </h1>
        <p
          class="mt-5 max-w-measure text-lg leading-relaxed text-muted text-pretty"
        >
          {intro}
        </p>

        {
          project && (
            <dl class="mt-7 flex flex-wrap items-baseline gap-x-3">
              <dt class="label">Run for</dt>
              <dd class="font-mono text-sm text-muted">
                {project.href ? (
                  <a
                    href={project.href}
                    class="!text-accent underline decoration-accent/40 underline-offset-4 transition-colors duration-150 hover:decoration-accent"
                  >
                    {project.name}
                  </a>
                ) : (
                  project.name
                )}
                {project.note && ` (${project.note})`}
              </dd>
            </dl>
          )
        }
      </header>

      <main class="pt-14">
        <slot />
      </main>

      {
        kind === "reference" && (
          <p class="label mt-20 border-t border-border pt-6">
            Reference · noindex · maintained, not frozen — this page always
            shows the site as it is now
          </p>
        )
      }
      {
        kind === "experiment" && (
          <p class="label mt-20 border-t border-border pt-6">
            Experiment · frozen once dated — a record, never updated to match
            the site
          </p>
        )
      }
    </div>

    <SiteFooter />
  </div>
</BaseLayout>
