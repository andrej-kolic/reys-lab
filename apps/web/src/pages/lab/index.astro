---
import LabLayout from "../../layouts/LabLayout.astro";
import Section from "../../components/lab/Section.astro";
import pkg from "../../../package.json";

const sections = [
  {
    href: "/lab/type",
    title: "Type",
    label: "01 / Specimen",
    body: "Settled: Outfit over IBM Plex Mono. The full specimen, the micro-label tracking ramp, and the scale — the place to check a size before it ships.",
  },
  {
    href: "/lab/colour",
    title: "Colour",
    label: "02 / Palette",
    body: "The settled palette — violet c — as live token swatches, a contrast matrix computed in the page against WCAG AA (the minimum text-contrast standard), the accent policy, and a glow ramp.",
  },
  {
    href: "/lab/components",
    title: "Components",
    label: "03 / Parts",
    body: "The pieces that actually recur: project card, post list item, micro-label, code block, link states, timeline node.",
  },
  {
    href: "/lab/experiments/01-choosing-a-palette",
    title: "Experiment 01",
    label: "Settled · 2026-09-20",
    body: "Choosing a palette. Four built, three judged at full-screen scale, violet c won. Frozen: the losing palettes still render there and nowhere else.",
  },
];

const readout = [
  { label: "Build", value: new Date().toISOString().replace("T", " ").slice(0, 16) + " UTC" },
  { label: "Astro", value: pkg.dependencies.astro.replace("catalog:", "7.3.3") },
  { label: "Tailwind", value: pkg.dependencies.tailwindcss.replace(/^[\^~]/, "") },
  { label: "Typeface", value: "Outfit + Plex Mono" },
  { label: "Palette", value: "violet c" },
  { label: "Output", value: "static / no adapter" },
  { label: "Status", value: "building" },
  { label: "Routes", value: "6" },
  // Kept to a multiple of three: the grid draws its gaps with a background
  // colour, so a half-filled last row shows up as a bare slab.
  { label: "AA floor", value: "4.5:1 held" },
];
---

<LabLayout
  title="The Lab"
  eyebrow="Design playground"
  intro="Perceptual questions need an instrument, not an argument. So: render the candidates, deploy them, look at them on a phone, and let the winner be obvious. Type and palette went that way and are settled; what is settled lives here as a specimen, and what it was settled over is kept as a dated experiment."
>
  <Section
    id="readout"
    title="Instrument readout"
    note="The lab concept, kept honest: these are real build values, not decorative chrome. The reference site this borrows from is dense because it has live numbers — density without data is fake."
  >
    <dl
      class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-3"
    >
      {
        readout.map((item) => (
          <div class="bg-surface px-4 py-4">
            <dt class="label">{item.label}</dt>
            <dd class="mt-2 font-mono text-sm tracking-tight text-ink">
              {item.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section id="sections" title="Sections">
    <div class="grid gap-4 sm:grid-cols-3">
      {
        sections.map((section) => (
          <a
            href={section.href}
            class="group flex flex-col rounded-xl border border-border bg-surface p-5 transition-colors duration-150 hover:border-accent"
          >
            <p class="label">{section.label}</p>
            <h3 class="mt-3 font-display text-xl font-semibold tracking-tight transition-colors duration-150 group-hover:text-accent">
              {section.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{section.body}</p>
          </a>
        ))
      }
    </div>
  </Section>

  <Section
    id="open"
    title="Still open"
    note="What this playground exists to settle. Decided by looking, not by arguing. Palette and type are no longer on this list."
  >
    <ul class="max-w-measure space-y-3 text-muted">
      {
        [
          "Whether the gradient signature on the hero name earns its place.",
          "How far to push the lab concept before it tips into cringe.",
        ].map((item) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-warm" />
            <span class="leading-relaxed">{item}</span>
          </li>
        ))
      }
    </ul>
  </Section>
</LabLayout>
