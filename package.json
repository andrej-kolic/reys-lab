{
  "name": "reys-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "gate": "turbo run gate",
    "dev": "turbo run dev",
    "preview": "turbo run preview --filter=@reys-lab/web",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "deploy": "turbo run deploy",
    "versions": "node scripts/versions.js",
    "rules:install": "rulesync install && rulesync generate -f rules -t claudecode,cursor",
    "rules:outdated": "pnpm dlx github:andrej-kolic/playbook rules --check",
    "rules:update": "rulesync install --update && rulesync generate -f rules -t claudecode,cursor"
  },
  "devDependencies": {
    "rulesync": "27.0.0",
    "turbo": "catalog:"
  }
}
