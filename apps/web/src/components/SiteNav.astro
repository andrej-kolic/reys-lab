---
import { nav, isCurrent, site } from "../lib/site";

const path = Astro.url.pathname;
---

<header class="border-b border-border/70">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-3 px-5 py-4"
  >
    {/*
      Large and light, not small and bold. At 16px/700 the wordmark was body
      size carrying identity, which is why the header read flat; the reference
      sets its wordmark large at a low weight and this follows it. 20px against
      the 11px mono nav labels is the hierarchy the row was missing.

      Deliberately undecorated. On the home page these same words appear again
      in the hero at 60px, and experiment 02 is still choosing whether that one
      carries a gradient. A treatment here would compete with it.
    */}
    <a
      href="/"
      class="font-display text-xl font-medium tracking-tight transition-colors duration-150 hover:text-accent"
    >
      {site.name}
    </a>

    <nav class="ml-auto flex flex-wrap gap-x-5 gap-y-2" aria-label="Primary">
      {
        nav.map((item) => {
          const current = isCurrent(path, item);
          return (
            <a
              href={item.href}
              aria-current={current ? "page" : undefined}
              /*
                Current state is the warm accent — but never only the warm
                accent. Roughly 8% of men cannot reliably separate these two
                hues, so the weight and the underline carry the same signal
                on their own.
              */
              class:list={[
                "label transition-colors duration-150 hover:!text-ink",
                current
                  ? "!font-semibold !text-warm underline decoration-warm/60 underline-offset-[6px]"
                  : "",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
