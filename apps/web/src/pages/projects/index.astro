---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";

// Hand-ordered by the `order` field, best first. Never chronological —
// chronology buries the best work under the most recent.
//
// Past roughly eight entries this page grows pill filters by stack, not a
// second URL level: /projects/<category>/<slug> would make the nav a tree.
const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// The eyebrow carries a fact the h1 does not, rather than restating it.
const count = `${projects.length} ${projects.length === 1 ? "project" : "projects"}`;
---

<SiteLayout
  title="Projects"
  description="Things built, with the tradeoff attached."
>
  <header class="border-b border-border pb-10">
    <p class="label !text-accent">{count}</p>
    <h1
      class="mt-3 font-display text-5xl leading-[1.05] font-bold tracking-tight sm:text-6xl"
    >
      Projects
    </h1>
    <p class="mt-5 max-w-measure text-lg leading-relaxed text-muted text-pretty">
      Each one has a write-up: the problem, the approach, the tradeoff it cost
      and what I would do differently. Repo and demo links live on those pages
      rather than here, because the write-up is the part worth reading.
    </p>
  </header>

  <div class="grid gap-4 pt-12 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project) => (
        <ProjectCard
          href={`/projects/${project.id}`}
          label={project.data.stack[0] ?? "Project"}
          title={project.data.title}
          description={project.data.description}
          stack={project.data.stack}
          status={project.data.status}
        />
      ))
    }
  </div>
</SiteLayout>
