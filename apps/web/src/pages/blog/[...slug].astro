---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { formatDate } from "../../lib/site";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);

// The table of contents is the sub-navigation for a long page — not more
// routes. From 1280px it is a sticky column in the right margin, outside the
// 68ch measure, so the text column stays centred; below that the margin is
// too narrow, and it folds into a "Contents" button in the pinned breadcrumb
// bar. Inline at the top it put a long list between the description and the
// first sentence. Settled by experiment 05 (#48).
//
// Only h2 is listed. A two-level contents on a 2000-word post is a map of a
// map, and h3s are section detail rather than destinations.
const toc = headings.filter((heading) => heading.depth === 2);

const linkClass =
  "text-sm text-muted underline decoration-border underline-offset-4 transition-colors duration-150 hover:text-accent hover:decoration-accent";
---

<SiteLayout
  title={post.data.title}
  description={post.data.description}
  width="measure"
>
  <Fragment slot="subnav">
    <Breadcrumb
      trail={[{ href: "/blog", label: "Blog" }]}
      current={post.data.title}
    />
    {
      toc.length > 2 && (
        <>
          <button
            type="button"
            popovertarget="toc-popover"
            class="label -my-2 ml-auto cursor-pointer py-2 transition-colors duration-150 hover:!text-label-hover xl:hidden"
          >
            Contents <span aria-hidden="true">▾</span>
          </button>
          <nav
            id="toc-popover"
            popover
            class="contents-popover rounded-xl border border-border bg-surface px-5 py-4"
            aria-label="Table of contents"
          >
            <ol class="space-y-1.5">
              {toc.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`} class={linkClass}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </>
      )
    }
  </Fragment>

  <header class="border-b border-frame pb-8">
    <time
      datetime={formatDate(post.data.date)}
      class="label block tabular-nums !text-accent"
    >
      {formatDate(post.data.date)}
    </time>
    <h1
      class="mt-3 font-display text-4xl leading-[1.1] font-bold tracking-tight text-balance sm:text-5xl"
    >
      {post.data.title}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted text-pretty">
      {post.data.description}
    </p>
    {
      post.data.tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="tag">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </header>

  <div class="relative">
    {
      toc.length > 2 && (
        <nav
          class="absolute top-10 bottom-0 left-full ml-12 hidden w-52 xl:block"
          aria-label="Table of contents"
        >
          <div class="sticky top-[calc(var(--site-header-height)+2rem)] max-h-[calc(100dvh-var(--site-header-height)-4rem)] overflow-y-auto">
            <p class="label">Contents</p>
            <ol class="mt-3 space-y-1.5">
              {toc.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`} class={linkClass}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      )
    }

    <article class="prose pt-10">
      <Content />
    </article>
  </div>
</SiteLayout>

<script>
  // A pick jumps to its section; the list closes rather than cover the
  // heading it just jumped to. Closing hands focus back to the button, which
  // would keep the header pinned on a phone (:focus-within), so it is let go;
  // Tab still carries on from the section jumped to.
  const popover = document.querySelector<HTMLElement>("#toc-popover");
  popover?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) {
      popover.hidePopover();
      if (document.activeElement instanceof HTMLElement) {
        document.activeElement.blur();
      }
    }
  });

  // From 1280px the side column shows the same list, so an open one closes.
  matchMedia("(width >= 80rem)").addEventListener("change", (event) => {
    if (event.matches) popover?.hidePopover();
  });
</script>

<style>
  /* A popover opens in the top layer, centred by the browser's own styles.
     This drops it just under the pinned header, its right edge on the
     reading column's (max-w-2xl, 42rem, inside 1.25rem of padding). 100%
     rather than 100vw: a fixed box's 100% is the window without its
     scrollbar, which is what the column is centred in. */
  .contents-popover {
    position: fixed;
    inset: auto;
    margin: 0;
    top: calc(var(--site-header-height) + 0.5rem);
    right: max(1.25rem, calc((100% - 42rem) / 2 + 1.25rem));
    width: min(20rem, calc(100% - 2.5rem));
    max-height: calc(100dvh - var(--site-header-height) - 2rem);
    overflow-y: auto;
    color: inherit;
  }
</style>
