---
import { Code } from "astro-expressive-code/components";
import LabLayout from "../../../layouts/LabLayout.astro";
import { labelFor } from "../../../lib/reference";
import Section from "../../../components/lab/Section.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import ListRow from "../../../components/ListRow.astro";
import Timeline from "../../../components/Timeline.astro";

// Samples render through the real components, not copies of their markup —
// this page is maintained, and a copy stops matching the site the moment the
// component changes.
const projects = [
  {
    title: "Grounder",
    summary:
      "A CLI that links a project to a local markdown vault, so an agent keeps its memory between sessions instead of starting cold every time.",
    stack: ["TypeScript", "Node", "Markdown"],
    result: "In daily use",
  },
  {
    title: "Rookie Trader",
    summary:
      "A paper-trading harness for testing strategies against historical data without risking a cent or a convincing backtest.",
    stack: ["Python", "Pandas", "AWS"],
    result: "14 strategies tested",
  },
];

const posts = [
  {
    date: "2026-09-19",
    title: "The adapter is the lock-in",
    description:
      "Why a static build and a dist directory buy more portability than any deployment abstraction.",
  },
  {
    date: "2026-09-04",
    title: "Deciding by looking",
    description:
      "Two weeks of arguing about fonts in prose, settled in ten minutes by a route that renders them.",
  },
  {
    date: "2026-08-21",
    title: "A monorepo with one app in it",
    description:
      "Boundaries are cheap to draw early and expensive to draw late. Abstractions are the opposite.",
  },
];

const experiments = [
  {
    number: "02",
    title: "The hero signature",
    project: "Rey’s Lab",
    status: "Open",
    date: undefined,
    summary:
      "Whether the name carries a multi-hue gradient, and drawn from what.",
  },
  {
    number: "01",
    title: "Choosing a palette",
    project: "Rey’s Lab",
    status: "Settled",
    date: "2026-09-20",
    summary:
      "Four palettes built, three judged at full-screen scale, violet c won.",
  },
];

const timeline = [
  {
    years: "2026 —",
    role: "Building Rey’s Lab",
    org: "Personal",
    detail: "Astro, Tailwind, Cloudflare. A portfolio that is also the work sample.",
    projects: ["Rey’s Lab", "Grounder"],
  },
  {
    years: "2024 – 2026",
    role: "Senior Frontend Engineer",
    org: "Placeholder Company",
    detail: "React and AWS. Design systems, build pipelines, and the odd backend.",
    projects: ["Rookie Trader"],
  },
  {
    years: "2021 – 2024",
    role: "Frontend Engineer",
    org: "Placeholder Company",
    detail: "Where the habit of writing the tradeoff down started.",
  },
];

const deployCode = `{
  "name": "reys-lab-web",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "../../apps/web/dist",
    "not_found_handling": "404-page"
  }
}`;

const shellCode = `pnpm --filter @reys-lab/deploy-cloudflare deploy`;
---

<LabLayout
  title="Components"
  eyebrow={labelFor("/lab/reference/components")}
  intro="The pieces that actually recur, built from tokens rather than ad-hoc values, and rendered here through the same components the site uses."
  kind="reference"
>
  <Section
    id="labels"
    rule={false}
    title="Micro-labels"
    note="The single strongest through-line in all four reference sites, without exception: mono, uppercase, wide tracking, small, quiet. Defined once as a utility so it cannot drift."
  >
    <div
      class="flex flex-wrap items-center gap-x-10 gap-y-5 rounded-xl border border-border bg-surface px-6 py-6"
    >
      <span class="label">Experiment 04</span>
      <span class="label !text-accent">Shipped</span>
      <span class="label !text-warm">Currently</span>
      <span class="label flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        Lab notes
      </span>
      <span class="font-mono text-sm tabular-nums text-muted">
        2026 · 3.41 s · 0.35 KiB
      </span>
    </div>
  </Section>

  <Section
    id="project-card"
    rule={false}
    title="Project card"
    note="Where an employer decides whether to click. Outcome, name, what it is in one sentence, stack — no adjectives."
  >
    <div class="grid gap-4 sm:grid-cols-2">
      {
        projects.map((project) => (
          <ProjectCard
            href="#project-card"
            title={project.title}
            description={project.summary}
            stack={project.stack}
            status={project.result}
          />
        ))
      }
    </div>
  </Section>

  <Section
    id="post-item"
    rule={false}
    title="Post list item"
    note="Chronological, scannable, quiet. The blog index is not a place for display type."
  >
    <div class="overflow-hidden rounded-xl border border-border bg-surface">
      {
        posts.map((post) => (
          <ListRow
            href="#post-item"
            meta={post.date}
            datetime={post.date}
            title={post.title}
            description={post.description}
          />
        ))
      }
    </div>
  </Section>

  <Section
    id="experiment-row"
    rule={false}
    title="Experiment row"
    note="The same row on the lab index. Number over project, set apart; status in a fixed-width column so every description wraps at the same point."
  >
    <div class="overflow-hidden rounded-xl border border-border bg-surface">
      {
        experiments.map((experiment) => (
          <ListRow
            href="#experiment-row"
            meta={`Experiment ${experiment.number}`}
            metaSub={experiment.project}
            title={experiment.title}
            description={experiment.summary}
            tag={experiment.status}
            tagSub={experiment.date}
            tagTone={experiment.status === "Open" ? "warm" : "dim"}
          />
        ))
      }
    </div>
  </Section>

  <Section
    id="code"
    rule={false}
    title="Code block"
    note="A primary visual element on a dev blog, not an afterthought. Expressive Code, with its frame, border and background bound to the palette tokens — so it re-skins with the rest of the site instead of sitting in it like a foreign object."
  >
    <div class="space-y-5">
      <Code code={deployCode} lang="json" title="deploy/cloudflare/wrangler.jsonc" />
      <Code code={shellCode} lang="bash" frame="terminal" />
    </div>
  </Section>

  <Section
    id="prose"
    rule={false}
    title="Prose"
    note="The other half of the job. Marketing energy on the home page, a good reading environment here — measure held to roughly 68 characters, calmer type, less chrome."
  >
    <div class="max-w-measure rounded-xl border border-border bg-surface px-6 py-8">
      <p class="leading-[1.75] text-ink">
        Astro builds two ways. Static output emits plain HTML, CSS and
        JavaScript that any host on earth can serve. Server output needs an
        adapter, and an adapter is a build-time plugin that compiles the site
        into one vendor&rsquo;s runtime format.
      </p>
      <p class="mt-5 leading-[1.75] text-ink">
        That puts the vendor inside the application package, underneath
        everything, where no amount of deployment wrapping can reach it. The
        usual way this happens is not a decision at all: a site is static{" "}
        <em class="font-semibold not-italic">except</em> for one contact form, the
        form needs a server, and the whole site follows it into a runtime it can
        never leave. So the rule is{" "}
        <a
          href="#prose"
          class="text-accent underline decoration-accent/40 underline-offset-4 transition-colors duration-150 hover:decoration-accent"
        >
          static output, no adapter
        </a>, and anything that genuinely needs a server becomes its own
        deployable.
      </p>
    </div>
  </Section>

  <Section
    id="links"
    rule={false}
    title="Link states"
    note="Rest, hover and focus shown together, because the focus ring is the state most often left undesigned and it is the one that carries the accessibility claim. Tab through the live link to check the real thing."
  >
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-xl border border-border bg-surface p-5">
        <p class="label">Rest</p>
        <p class="mt-3">
          <span
            class="text-accent underline decoration-accent/40 underline-offset-4"
            >a portable build</span
          >
        </p>
      </div>
      <div class="rounded-xl border border-border bg-surface p-5">
        <p class="label">Hover</p>
        <p class="mt-3">
          <span class="text-accent underline decoration-accent underline-offset-4"
            >a portable build</span
          >
        </p>
      </div>
      <div class="rounded-xl border border-border bg-surface p-5">
        <p class="label">Focus · live, tab to it</p>
        <p class="mt-3">
          <a
            href="#links"
            class="text-accent underline decoration-accent/40 underline-offset-4 transition-colors duration-150 hover:decoration-accent"
            >a portable build</a
          >
        </p>
      </div>
    </div>
  </Section>

  <Section
    id="timeline"
    title="Timeline node"
    note="The spine of /cv. Years are mono and small, set left of the line inside the text column; the line is the only place a bright colour runs vertically."
  >
    <Timeline roles={timeline} />
  </Section>
</LabLayout>
