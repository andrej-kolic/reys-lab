---
import BaseLayout from "./BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SubNav from "../components/SubNav.astro";
import { site } from "../lib/site";

interface Props {
  /** Page title. The site name is appended unless this is the home page. */
  title: string;
  description?: string;
  /** Skips the ` · Rey’s Lab` suffix. Home only. */
  bare?: boolean;
  noindex?: boolean;
  /**
   * Width of the content column. Prose pages hold the reading measure, but
   * left-aligned inside the same 5xl frame as the nav and strip, so every page
   * shares one left edge; a centred narrow column started ~100px further in.
   */
  width?: "wide" | "measure";
}

const {
  title,
  description,
  bare = false,
  noindex = false,
  width = "wide",
} = Astro.props;
---

<BaseLayout
  title={bare ? title : `${title} · ${site.name}`}
  description={description}
  noindex={noindex}
>
  <div class="page-glow flex min-h-screen flex-col">
    <SiteNav />
    {
      Astro.slots.has("subnav") && (
        <SubNav>
          <slot name="subnav" />
        </SubNav>
      )
    }

    <main class="mx-auto w-full max-w-5xl grow px-5 pt-12 pb-16">
      {
        width === "measure" ? (
          <div class="max-w-2xl">
            <slot />
          </div>
        ) : (
          <slot />
        )
      }
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
