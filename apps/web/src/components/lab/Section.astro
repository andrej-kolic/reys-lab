---
interface Props {
  id: string;
  title: string;
  note?: string;
  /**
   * The line under the heading. Off where the section's content is a box with
   * its own edge, which would otherwise draw a second line right below it.
   */
  rule?: boolean;
}

const { id, title, note, rule = true } = Astro.props;
---

<section id={id} class="mb-20">
  <div class:list={["mb-7", rule && "border-b border-divider pb-3"]}>
    <h2 class="font-display text-2xl font-semibold tracking-tight">
      <a href={`#${id}`} class="transition-colors duration-150 hover:text-accent"
        >{title}</a
      >
    </h2>
    {note && <p class="mt-2 max-w-measure text-sm text-muted">{note}</p>}
  </div>
  <slot />
</section>
