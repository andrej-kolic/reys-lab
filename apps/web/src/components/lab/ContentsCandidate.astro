---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Breadcrumb from "../Breadcrumb.astro";

/**
 * One candidate page for experiment 05: a blog post as it would ship, with
 * only the contents moved.
 *
 * The header and the inline box are copied from blog/[...slug].astro rather
 * than imported, because that page draws one placement and this needs six.
 * The copy is a record, not a second source of truth.
 *
 * The post is invented, so the page does not change when a real one does. It
 * has 13 sections, as many as the post that raised the question (#47), some
 * with long headings, and placeholder copy of a similar length, so the sticky
 * column has a real page to scroll against.
 */

interface Props {
  candidate: "inline" | "none" | "rail" | "rail-toggle" | "subnav" | "rail-subnav";
  name: string;
}

const { candidate, name } = Astro.props;

const headings = [
  "Why bother",
  "The old machine",
  "Choosing the parts",
  "Installing the system",
  "Moving the data",
  "Backups that actually run",
  "What broke in the first week",
  "What's next",
  "Conclusion",
  "Appendix: the parts list with prices",
  "Appendix: the backup schedule",
  "Appendix: commands I ran, in order",
  "Appendix: what I would buy differently next time",
];

const slug = (text: string) =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9 -]/g, "")
    .replace(/ /g, "-");

const toc = headings.map((text) => ({ text, slug: slug(text) }));

const filler = [
  "Placeholder copy. The structure is real; the words are not. This paragraph stands in for a section of a post, about as long as a real paragraph, so the page scrolls the way a finished post will.",
  "A second paragraph, shorter, because real sections vary. Some carry a table or a code block instead.",
  "A third paragraph closes the longer sections. The point of the page is the contents, not this text: scroll it, jump from the contents to a section and back, and watch where the contents sit while you read.",
];

/** Sections alternate between three and two paragraphs. */
const paragraphs = (index: number) =>
  index % 2 === 0 ? filler : filler.slice(0, 2);

const linkClass =
  "text-sm text-muted underline decoration-border underline-offset-4 transition-colors duration-150 hover:text-accent hover:decoration-accent";
---

<SiteLayout
  title={`${name} · Experiment 05`}
  description="A candidate placement for a blog post's contents."
  width="measure"
  noindex
>
  <Fragment slot="subnav">
    <Breadcrumb
      trail={[
        { href: "/lab", label: "Lab" },
        { href: "/lab/experiments/05-the-contents-box", label: "Experiment 05" },
      ]}
      current={name}
    />
    {
      /*
        The button sits on the right of the strip the breadcrumb is on, where
        /lab keeps its jump links. The strip is pinned, so the list is in
        reach at every width and scroll position. F shows it only below
        1280px, where its side column is hidden.
      */
      (candidate === "subnav" || candidate === "rail-subnav") && (
        <>
          <button
            type="button"
            popovertarget="contents"
            class:list={[
              "label ml-auto cursor-pointer transition-colors duration-150 hover:!text-label-hover",
              candidate === "rail-subnav" && "xl:hidden",
            ]}
          >
            Contents <span aria-hidden="true">▾</span>
          </button>
          <nav
            id="contents"
            popover
            class="contents-popover rounded-xl border border-border bg-surface px-5 py-4"
            aria-label="Table of contents"
          >
            <ol class="space-y-1.5">
              {toc.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`} class={linkClass}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </>
      )
    }
  </Fragment>

  <header class="border-b border-frame pb-8">
    <time datetime="2026-10-27" class="label block tabular-nums !text-accent">
      2026-10-27
    </time>
    <h1
      class="mt-3 font-display text-4xl leading-[1.1] font-bold tracking-tight text-balance sm:text-5xl"
    >
      Rebuilding a home server
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted text-pretty">
      A weekend of replacing an old home server, and what moving the data
      taught me.
    </p>
    <div class="mt-6 flex flex-wrap gap-2">
      <span class="tag">hardware</span>
      <span class="tag">notes</span>
    </div>
  </header>

  {
    candidate === "inline" && (
      <nav
        class="mt-8 rounded-xl border border-border bg-surface px-6 py-5"
        aria-label="Table of contents"
      >
        <p class="label">Contents</p>
        <ol class="mt-3 space-y-1.5">
          {toc.map((heading) => (
            <li>
              <a href={`#${heading.slug}`} class={linkClass}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  {
    candidate === "rail-toggle" && (
      <details class="mt-8 rounded-xl border border-border bg-surface px-6 py-4 xl:hidden">
        <summary class="label cursor-pointer">Contents</summary>
        <ol class="mt-3 space-y-1.5">
          {toc.map((heading) => (
            <li>
              <a href={`#${heading.slug}`} class={linkClass}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    )
  }

  <div class="relative">
    {
      /*
        The column sits in the right margin, outside the 68ch measure, so the
        text column stays centred where it is. It only appears where the
        margin is wide enough: at 1280px it is about 300px.
      */
      (candidate === "rail" ||
        candidate === "rail-toggle" ||
        candidate === "rail-subnav") && (
        <nav
          class="absolute top-10 bottom-0 left-full ml-12 hidden w-52 xl:block"
          aria-label="Table of contents"
        >
          <div class="sticky top-[calc(var(--site-header-height)+2rem)]">
            <p class="label">Contents</p>
            <ol class="mt-3 space-y-1.5">
              {toc.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`} class={linkClass}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      )
    }

    <article class="prose pt-10">
      {filler.map((text) => <p>{text}</p>)}
      {
        toc.map((heading, index) => (
          <>
            <h2 id={heading.slug}>{heading.text}</h2>
            {paragraphs(index).map((text) => (
              <p>{text}</p>
            ))}
          </>
        ))
      }
    </article>
  </div>
</SiteLayout>

<script>
  // A link in the list jumps to its section; the list has done its job then,
  // so it closes rather than covering the heading it just jumped to.
  const popover = document.querySelector<HTMLElement>("#contents[popover]");
  popover?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) {
      popover.hidePopover();
    }
  });
</script>

<style>
  /* A popover opens in the top layer, centred by the browser's own styles.
     This drops it just under the pinned header, its right edge on the
     reading column's (max-w-2xl, 42rem, inside 1.25rem of padding). */
  .contents-popover {
    position: fixed;
    inset: auto;
    margin: 0;
    top: calc(var(--site-header-height) + 0.5rem);
    right: max(1.25rem, calc((100vw - 42rem) / 2 + 1.25rem));
    width: min(20rem, calc(100vw - 2.5rem));
    max-height: calc(100dvh - var(--site-header-height) - 2rem);
    overflow-y: auto;
    color: inherit;
  }
</style>
