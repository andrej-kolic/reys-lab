---
import SiteLayout from "../layouts/SiteLayout.astro";
import Timeline from "../components/Timeline.astro";
import { site } from "../lib/site";

// About merged in here, 2026-09-20. A CV page and an About page tell the same
// story twice and then neither stays current. So: narrative, timeline,
// contact, PDF — one page.

// Set by hand whenever this page's content changes. A build date would move
// on every deploy and claim edits that never happened.
const updated = "2026-09-23";

const intro = [
  "Placeholder. Two paragraphs of narrative go here — the part that used to be an About page. Who I am, what I work on, and what I am looking for, written as prose rather than as a bullet list of technologies.",
  "The second paragraph is the one that earns the read: what kind of problem I like, and the sort of engineering judgement I bring to it. Evidence beats adjectives, so it should point at something on this site rather than assert a quality.",
];

const roles = [
  {
    years: "2026 —",
    role: "Building Rey’s Lab",
    org: "Personal",
    detail:
      "Astro, Tailwind and Cloudflare, built as a monorepo with a static-only app and deployment kept behind the dist/ directory. Decisions recorded as dated experiments.",
    projects: ["Rey’s Lab", "Grounder"],
  },
  {
    years: "2024 – 2026",
    role: "Senior Frontend Engineer",
    org: "Placeholder Company",
    detail:
      "Placeholder. React and AWS: design systems, build pipelines, and the occasional backend when the boundary made more sense on the other side.",
    projects: ["Rookie Trader"],
  },
  {
    years: "2021 – 2024",
    role: "Frontend Engineer",
    org: "Placeholder Company",
    detail:
      "Placeholder. Where the habit of writing down the tradeoff — rather than only the decision — started.",
    projects: [],
  },
];
---

<SiteLayout
  title="CV"
  description={`${site.author} — experience, and how to get in touch.`}
>
  <header class="border-b border-border/70 pb-10">
    <p class="label !text-accent">Updated {updated}</p>
    <h1
      class="mt-3 font-display text-5xl leading-[1.05] font-bold tracking-tight sm:text-6xl"
    >
      CV
    </h1>
    <div class="mt-6 max-w-measure space-y-5">
      {
        intro.map((paragraph) => (
          <p class="text-lg leading-relaxed text-muted text-pretty">
            {paragraph}
          </p>
        ))
      }
    </div>
    <div class="mt-8 flex flex-wrap gap-x-5 gap-y-3">
      {/*
        Recruiters ask for a PDF and it costs a link. Whether it is
        hand-maintained or generated from this same data is still open.
      */}
      <a href="/cv.pdf" class="btn-primary">Download PDF</a>
      <a href={`mailto:${site.email}`} class="btn-secondary">Email</a>
    </div>
  </header>

  <section class="pt-14">
    <h2 class="label mb-8 !text-warm">Experience</h2>

    <Timeline roles={roles} />
  </section>
</SiteLayout>
