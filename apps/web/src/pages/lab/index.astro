---
import LabLayout from "../../layouts/LabLayout.astro";
import Section from "../../components/lab/Section.astro";
import ListRow from "../../components/ListRow.astro";
import pkg from "../../../package.json";
import { countRoutes } from "../../lib/routes";
import {
  byStatus,
  href as experimentHref,
  owner,
} from "../../lib/experiments";

// Counted rather than typed. The readout's whole claim is that these are real
// build values, and a hand-maintained route count is the one number on it that
// would quietly go stale the next time a page is added.

// Open above settled: an open experiment is the live one and should read that
// way. Both lists come from the registry, so this page cannot disagree with a
// project page about which experiments exist.
const open = byStatus("open");
const settled = byStatus("settled");

// The eyebrow carries a fact the h1 does not, like the other list pages.
const total = open.length + settled.length;
const count = `${total} ${total === 1 ? "experiment" : "experiments"} · ${open.length} open`;

const reference = [
  {
    href: "/lab/reference/type",
    title: "Type",
    label: "Specimen",
    body: "Outfit over IBM Plex Mono. The full specimen, the micro-label tracking ramp and the scale — the place to check a size before it ships.",
  },
  {
    href: "/lab/reference/colour",
    title: "Colour",
    label: "Palette",
    body: "Violet c as live token swatches, plus a contrast matrix computed in the page against WCAG AA — the minimum text-contrast standard.",
  },
  {
    href: "/lab/reference/scale",
    title: "Scale",
    label: "Measured",
    body: "The palette plotted by brightness, colourfulness and hue. A measurement rather than a specification — including the finding that its steps are eleven times apart, which is why it is not generated.",
  },
  {
    href: "/lab/reference/components",
    title: "Components",
    label: "Parts",
    body: "The pieces that actually recur: project card, list row, micro-label, code block, link states, timeline node.",
  },
];

const readout = [
  { label: "Build", value: new Date().toISOString().replace("T", " ").slice(0, 16) + " UTC" },
  { label: "Astro", value: pkg.dependencies.astro.replace("catalog:", "7.3.3") },
  { label: "Tailwind", value: pkg.dependencies.tailwindcss.replace(/^[\^~]/, "") },
  { label: "Typeface", value: "Outfit + Plex Mono" },
  { label: "Palette", value: "violet c" },
  { label: "Output", value: "static / no adapter" },
  { label: "Experiments", value: `${settled.length} settled · ${open.length} open` },
  { label: "Routes", value: String(await countRoutes()) },
  // Kept to a multiple of three: the grid draws its gaps with a background
  // colour, so a half-filled last row shows up as a bare slab.
  { label: "AA floor", value: "4.5:1 held" },
];
---

<LabLayout
  kind="index"
  title="The Lab"
  eyebrow={count}
  intro="Perceptual questions need an instrument, not an argument. So: build the candidates, deploy them, look at them on a phone, and let the winner be obvious. An experiment is a question answered that way, ending in a dated verdict — if it has no candidates and no verdict, it is a blog post instead. Every experiment names the project it was run for; the ones marked Rey’s Lab are this site, which has no other project page."
>
  <Section
    id="experiments"
    rule={false}
    title="Experiments"
    note="Dated and, once settled, frozen — a record, never updated to match the site. That is what stops the lab drifting into theme-park territory: a section containing only finished, dated work has nothing left to keep embellishing. An abandoned experiment leaves a permanent gap in the numbering, which is honest and is the price of the sequence."
  >
    <div class="overflow-hidden rounded-xl border border-border bg-surface">
      {
        [...open, ...settled].map((experiment) => (
          <ListRow
            href={experimentHref(experiment)}
            meta={`Experiment ${experiment.number}`}
            metaSub={owner(experiment).name}
            title={experiment.title}
            description={experiment.summary}
            tag={experiment.status === "open" ? "Open" : "Settled"}
            tagSub={
              experiment.status === "settled" ? experiment.date : undefined
            }
            tagTone={experiment.status === "open" ? "warm" : "dim"}
          />
        ))
      }
    </div>
  </Section>

  <Section
    id="reference"
    rule={false}
    title="Reference"
    note="The opposite contract to an experiment: these are maintained, and always show the site as it is now. They are noindex — a wall of swatches with no narrative makes a poor search landing page — but reachable from here, because the contrast matrix is worth verifying rather than taking on trust."
  >
    <div class="grid gap-4 sm:grid-cols-3">
      {
        reference.map((item) => (
          <a
            href={item.href}
            class="group flex flex-col rounded-xl border border-border bg-surface p-5 transition-colors duration-150 hover:border-accent"
          >
            <p class="label">{item.label}</p>
            <h3 class="mt-3 font-display text-xl font-semibold tracking-tight transition-colors duration-150 group-hover:text-accent">
              {item.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
          </a>
        ))
      }
    </div>
  </Section>

  <Section
    id="readout"
    rule={false}
    title="Instrument readout"
    note="The lab concept, kept honest: these are real build values, not decorative chrome. The reference site this borrows from is dense because it has live numbers — density without data is fake."
  >
    <dl
      class="grid grid-cols-2 grid-ruled overflow-hidden rounded-xl border border-border sm:grid-cols-3"
    >
      {
        readout.map((item) => (
          <div class="bg-surface px-4 py-4">
            <dt class="label">{item.label}</dt>
            <dd class="mt-2 font-mono text-sm tracking-tight text-ink">
              {item.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>
</LabLayout>
