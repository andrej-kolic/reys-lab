<script>
  /**
   * Two numbers, because the complaint was about loudness rather than
   * legibility:
   *
   *   separation — the fill's contrast against the page background. This is
   *                what "too aggressive" actually describes: how far the
   *                control jumps off the page. A candidate with no fill
   *                measures 1.00 by definition, and that is the floor.
   *   label      — ordinary text contrast, the label against whatever it
   *                actually sits on. 11px puts it under the 4.5:1 small-text
   *                floor, not the 3:1 large-text one.
   *
   * Everything is read off the rendered buttons rather than from the tokens
   * declared in the style block above. C and E paint a translucent fill, so
   * the declared colour is not what reaches the eye — the page shows through
   * it — and only the composited value describes the screen.
   */

  type Rgb = [number, number, number];

  /**
   * Rasterise the colour rather than parse it.
   *
   * The first version pulled the numbers out of the computed string with a
   * regex and took the first three as RGB. That works only while every
   * computed colour happens to serialise as `rgb()`. The soft fills are
   * `color-mix()`, which Chrome computes as `oklab(0.326 0.0027 -0.0778)` —
   * so the regex read 0.326, 0.0027 and 0.0778 as channel values, measured a
   * near-black button, and printed 1.17 where the truth was 1.31. It also
   * silently dropped the minus sign.
   *
   * The failure mode is the dangerous one: plausible numbers, no error, and
   * a strip that looks like it is working. Painting one pixel and reading it
   * back asks the same engine that painted the button, so any colour syntax
   * the browser understands — rgb, oklab, color(srgb ...), whatever comes
   * next — resolves to what is actually on screen.
   *
   * getImageData returns unpremultiplied RGBA, so a translucent fill still
   * gives its own colour and its alpha separately, which is what `over` then
   * composites. `fillStyle` keeps its previous value when handed something it
   * cannot parse, so it is reset to a sentinel first and a colour that fails
   * to move it is reported as transparent rather than as the last one read.
   */
  const swatch = document
    .createElement("canvas")
    .getContext("2d", { willReadFrequently: true })!;

  function parse(value: string): { rgb: Rgb; alpha: number } {
    // Two sentinels: a value the canvas rejects leaves fillStyle where it
    // was, so a colour it cannot parse lands on black once and on white
    // once, and the disagreement is the rejection.
    swatch.fillStyle = "#000000";
    swatch.fillStyle = value;
    const black = swatch.fillStyle;
    swatch.fillStyle = "#ffffff";
    swatch.fillStyle = value;
    if (swatch.fillStyle !== black) return { rgb: [0, 0, 0], alpha: 0 };

    swatch.clearRect(0, 0, 1, 1);
    swatch.fillRect(0, 0, 1, 1);
    const [r, g, b, a] = swatch.getImageData(0, 0, 1, 1).data;
    return { rgb: [r!, g!, b!], alpha: a! / 255 };
  }

  /** Source-over composite, which is what the browser did to paint it. */
  function over(fg: Rgb, alpha: number, bg: Rgb): Rgb {
    return [0, 1, 2].map(
      (i) => fg[i]! * alpha + bg[i]! * (1 - alpha),
    ) as Rgb;
  }

  function luminance([r, g, b]: Rgb): number {
    const channel = (value: number) => {
      const v = value / 255;
      return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
    };
    return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b);
  }

  function ratio(a: Rgb, b: Rgb): number {
    const la = luminance(a);
    const lb = luminance(b);
    return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
  }

  const probe = document.createElement("span");
  probe.setAttribute("aria-hidden", "true");
  probe.style.cssText =
    "position:absolute;width:0;height:0;opacity:0;pointer-events:none";
  document.body.append(probe);
  probe.style.color = "var(--lab-bg)";
  const page = parse(getComputedStyle(probe).color).rgb;

  /**
   * Opacity is not a background colour, so the filled candidates' hover state
   * does not show up in `backgroundColor` at all — it shows up in `opacity`,
   * which composites the whole element against the page. Folding it into the
   * alpha before compositing is what makes a dimmed solid and a strengthened
   * tint comparable on one number.
   */
  function measure(button: HTMLElement) {
    const styles = getComputedStyle(button);
    const element = Number(styles.opacity);
    const fill = parse(styles.backgroundColor);
    const painted = over(fill.rgb, fill.alpha * element, page);
    const ink = parse(styles.color);
    const inked = over(ink.rgb, ink.alpha * element, painted);
    return { separation: ratio(painted, page), label: ratio(inked, painted) };
  }

  for (const node of document.querySelectorAll<HTMLElement>("[data-measure]")) {
    const button = document.querySelector<HTMLElement>(
      `.cta[data-candidate="${node.dataset.measure}"]`,
    );
    if (!button) continue;

    // Transitions come off for the whole measurement, not just the forced
    // hover. getComputedStyle returns the value as currently animated, so a
    // read taken while anything is in flight is a read of the state being
    // left, not the state being asked for. The first version only disabled
    // them around the hover and reported every candidate's hover as
    // identical to its rest state — a silent, self-consistent wrong answer.
    const prior = button.style.transition;
    button.style.transition = "none";

    const rest = measure(button);

    // Force the hover rules rather than waiting for a pointer. An unmeasured
    // hover is the easiest place for a candidate to drop under the floor,
    // because nobody screenshots a hover.
    button.classList.add("is-hover");
    const hover = measure(button);
    button.classList.remove("is-hover");
    button.style.transition = prior;

    const worst = Math.min(rest.label, hover.label);
    const grade =
      worst >= 4.5
        ? "label AA"
        : worst >= 3
          ? "label AA large only"
          : "label fails";

    node.textContent =
      `separation ${rest.separation.toFixed(2)}:1 ` +
      `→ ${hover.separation.toFixed(2)}:1 hover · ` +
      `label ${rest.label.toFixed(2)}:1 ` +
      `→ ${hover.label.toFixed(2)}:1 · ${grade}`;
    node.style.color = worst >= 4.5 ? "var(--lab-dim)" : "var(--lab-warn)";
  }
</script>
