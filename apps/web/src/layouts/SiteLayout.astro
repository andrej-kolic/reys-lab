---
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SubNav from "../components/SubNav.astro";
import { site } from "../lib/site";

interface Props {
  /** Page title. The site name is appended unless this is the home page. */
  title: string;
  description?: string;
  /** Skips the ` · Rey’s Lab` suffix. Home only. */
  bare?: boolean;
  noindex?: boolean;
  /** Width of the content column. Prose pages hold the reading measure. */
  width?: "wide" | "measure";
  /** The link-preview image. See BaseLayout. */
  shareImage?: ImageMetadata;
}

const {
  title,
  description,
  bare = false,
  noindex = false,
  width = "wide",
  shareImage,
} = Astro.props;
---

<BaseLayout
  title={bare ? title : `${title} · ${site.name}`}
  description={description}
  noindex={noindex}
  shareImage={shareImage}
>
  <div class="page-glow flex min-h-screen flex-col">
    <SiteHeader>
      {
        Astro.slots.has("subnav") && (
          <SubNav width={width}>
            <slot name="subnav" />
          </SubNav>
        )
      }
    </SiteHeader>

    <main
      class:list={[
        "mx-auto w-full grow px-5 pt-12 pb-16",
        width === "measure" ? "max-w-2xl" : "max-w-5xl",
      ]}
    >
      <slot />
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
