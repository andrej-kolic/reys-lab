---
import type { ImageMetadata } from "astro";
import { Font } from "astro:assets";
import "../styles/global.css";
import { site } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  /** Sets `<meta name="robots" content="noindex, nofollow">`. */
  noindex?: boolean;
  /**
   * The link-preview image. Pages without one get a text-only preview; a
   * site-wide default image does not exist yet.
   */
  shareImage?: ImageMetadata;
}

const { title, description, noindex = false, shareImage } = Astro.props;

// Open Graph wants absolute URLs: a preview is fetched by another company's
// server, which cannot resolve a path relative to this page.
const url = new URL(Astro.url.pathname, Astro.site);
const imageUrl = shareImage && new URL(shareImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/*
      Link previews (Open Graph, https://ogp.me). Slack, Discord, WhatsApp and
      LinkedIn read og:*; X reads twitter:card and falls back to og:* for the
      rest. Testable only once deployed — no preview service can reach
      localhost.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={url} />
    {
      imageUrl && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:width" content={String(shareImage.width)} />
          <meta property="og:image:height" content={String(shareImage.height)} />
        </>
      )
    }
    <meta
      name="twitter:card"
      content={imageUrl ? "summary_large_image" : "summary"}
    />

    {/*
      The locked pairing, self-hosted and fingerprinted — /_headers keeps them
      cached for a year, so only a first visit waits for them at all.

      Outfit is preloaded because it is the one that moves the page. Astro's
      metric-matched fallback holds the vertical metrics exactly but not the
      widths, so headings and prose re-wrap when the real font swaps in;
      preloading starts the download at HTML parse rather than after the CSS,
      which is what closes most of that window on a cold cache.

      Plex Mono is not preloaded: its fallback measures identically at the sizes
      this site uses, so it costs nothing to let it swap, and preloading it
      would mean six files racing the one that matters.
    */}
    <Font cssVariable="--ff-outfit" preload />
    <Font cssVariable="--ff-plex-mono" />

    <slot name="head" />
  </head>
  <body>
    <slot />
    {/*
      iOS Safari applies `:active` only on a page that listens for touches, and
      the pressed state is what a tap shows (#21). The listener does nothing.
    */}
    <script>
      document.addEventListener("touchstart", () => {}, { passive: true });
    </script>
  </body>
</html>
