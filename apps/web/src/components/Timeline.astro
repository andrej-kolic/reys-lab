---
import RichText, { type Rich } from "./RichText.astro";

/**
 * The CV timeline, the mikes.cv model: a thin vertical line as the spine, a
 * dot per role, years in small mono to the left of the line, the role's
 * highlights as a bulleted list and its stack as tags under it.
 *
 * Year, dot and heading share one centre line: the year takes the heading's
 * 28px line box, and the dot sits 10px down so its 8px centre lands at 14px.
 *
 * From `sm` up, the list is indented by the width of the year column, so the
 * years sit inside the text column instead of hanging out past its edge. The
 * column is 9rem because "2026 – PRESENT" does not fit in 8rem.
 *
 * A role without `to` is current: it reads "– Present" and keeps the filled
 * dot, while a finished role's dot is hollow (experiment 07). A role that
 * starts and ends in the same year shows that year alone.
 */

export interface Role {
  from: string;
  /** End year. Absent while the role is current. */
  to?: string;
  role: string;
  /**
   * The heading. Most roles share a title, so the company is the part that
   * changes down the page; the title sits under it in small mono.
   */
  org: string;
  detail: Rich;
  /** A remark under the detail, such as why the detail is redacted. */
  note?: string;
  /** One bullet each, under the detail. */
  highlights?: Rich[];
  /** The tech used in this role, shown as tags: the CV's skills list. */
  stack?: string[];
}

interface Props {
  roles: Role[];
}

const { roles } = Astro.props;
---

{/* The spine: one border on the list, dots pulled onto it per role. */}
<ol class="ml-2 border-l border-frame pl-8 sm:ml-36">
  {
    roles.map((role) => (
      <li class="relative pb-12 last:pb-0">
        <span
          aria-hidden="true"
          class:list={[
            "absolute top-2.5 -left-[calc(2rem+4.5px)] h-2 w-2 rounded-full ring-4 ring-bg",
            role.to ? "border border-accent bg-bg" : "bg-accent",
          ]}
        />
        <p class="label !leading-7 whitespace-nowrap tabular-nums sm:absolute sm:top-0 sm:-left-[calc(2rem+9rem)] sm:w-36 sm:pr-4 sm:text-right">
          {role.to === role.from
            ? role.from
            : `${role.from} – ${role.to ?? "Present"}`}
        </p>
        <h3 class="font-display text-xl leading-7 font-semibold tracking-tight">
          {role.org}
        </h3>
        <p class="mt-1 font-mono text-sm text-dim">{role.role}</p>
        <p class="mt-3 max-w-measure leading-relaxed text-muted">
          <RichText text={role.detail} />
        </p>
        {role.note && (
          <p class="mt-2 max-w-measure text-sm text-dim">{role.note}</p>
        )}
        {role.highlights && role.highlights.length > 0 && (
          <ul class="mt-3 max-w-measure list-disc space-y-2 pl-5 leading-relaxed text-muted marker:text-dim">
            {role.highlights.map((highlight) => (
              <li>
                <RichText text={highlight} />
              </li>
            ))}
          </ul>
        )}
        {role.stack && role.stack.length > 0 && (
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <span class="label">Stack</span>
            {role.stack.map((item) => (
              <span class="tag">{item}</span>
            ))}
          </div>
        )}
      </li>
    ))
  }
</ol>
