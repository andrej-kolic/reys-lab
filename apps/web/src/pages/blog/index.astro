---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ListRow from "../../components/ListRow.astro";
import { formatDate, year } from "../../lib/site";

// Reverse-chronological, grouped by year. One-line rows rather than cards,
// which is what lets this reach fifty entries without pagination — and
// pagination would cost a navigation level and hide posts from crawlers.
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const years = [...new Set(posts.map((post) => year(post.data.date)))];

// The eyebrow carries a fact the h1 does not, rather than restating it.
const count = `${posts.length} ${posts.length === 1 ? "post" : "posts"}${
  years.length ? ` since ${years.at(-1)}` : ""
}`;
---

<SiteLayout
  title="Blog"
  description="Notes on building things, and what the decisions cost."
>
  <header class="border-b border-border pb-10">
    <p class="label !text-accent">{count}</p>
    <h1
      class="mt-3 font-display text-5xl leading-[1.05] font-bold tracking-tight sm:text-6xl"
    >
      Blog
    </h1>
    <p class="mt-5 max-w-measure text-lg leading-relaxed text-muted text-pretty">
      Prose: a story, an argument, a walkthrough. When something was decided by
      building the candidates and looking at them instead, it is an experiment
      and it lives in <a
        href="/lab"
        class="text-accent underline decoration-accent/40 underline-offset-4 transition-colors duration-150 hover:decoration-accent"
        >the lab</a
      >.
    </p>
  </header>

  <div class="pt-12">
    {
      years.map((groupYear) => (
        <section class="mb-12 last:mb-0">
          <h2 class="label mb-4 !text-warm">{groupYear}</h2>
          <div class="overflow-hidden rounded-xl border border-border bg-surface">
            {posts
              .filter((post) => year(post.data.date) === groupYear)
              .map((post) => (
                <ListRow
                  href={`/blog/${post.id}`}
                  meta={formatDate(post.data.date)}
                  datetime={formatDate(post.data.date)}
                  title={post.data.title}
                  description={post.data.description}
                />
              ))}
          </div>
        </section>
      ))
    }
  </div>
</SiteLayout>
