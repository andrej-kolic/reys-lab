---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { site } from "../../../lib/site";

// Privacy policy for the claude-history Google login app. Google requires it
// on the same domain as the app's homepage and requires it to say how the app
// accesses, uses, stores and shares Google user data.

// Set by hand to the last date this policy's text changed.
const updated = "2026-11-01";

// The Google account the app is registered on, not the site's own address.
const contact = "andrej.kolic.sm@gmail.com";

const sections = [
  {
    heading: "Who uses it",
    text: `claude-history is a personal tool run by ${site.author}. Its only user is my own Google account.`,
  },
  {
    heading: "What Google data it accesses",
    text: "Files in my own Google Drive, through the Google Drive API. Google grants it full Drive access, because rclone needs that to create and update files, but it only reads and writes the claude-history folder.",
  },
  {
    heading: "How it uses that data",
    text: "Only to upload my Claude Code chat history from my laptops to that folder and to download it back to my other laptop.",
  },
  {
    heading: "Where data is stored",
    text: "The backup files stay in my Google Drive. The Google login token stays in rclone's config file on my own laptops. There is no server, and nothing is stored anywhere else.",
  },
  {
    heading: "Sharing",
    text: "None. No data is sent to anyone else, sold, used for advertising or analytics, or used to train AI models.",
  },
  {
    heading: "Removing access",
    text: "Access can be revoked at any time at myaccount.google.com/permissions.",
  },
];
---

<SiteLayout
  title="claude-history privacy policy"
  description="How claude-history accesses, uses, stores and shares Google user data."
  noindex
  width="measure"
>
  <p class="label !text-accent">Updated {updated}</p>
  <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-balance">
    claude-history privacy policy
  </h1>
  <p class="mt-6 text-lg leading-relaxed text-muted text-pretty">
    Applies to <a href="/projects/claude-history">claude-history</a> only.
  </p>
  {
    sections.map(({ heading, text }) => (
      <section class="mt-10">
        <h2 class="font-display text-xl font-bold">{heading}</h2>
        <p class="mt-3 text-lg leading-relaxed text-muted text-pretty">
          {text}
        </p>
      </section>
    ))
  }
  <section class="mt-10">
    <h2 class="font-display text-xl font-bold">Contact</h2>
    <p class="mt-3 text-lg leading-relaxed text-muted text-pretty">
      <a href={`mailto:${contact}`}>{contact}</a>
    </p>
  </section>
</SiteLayout>
