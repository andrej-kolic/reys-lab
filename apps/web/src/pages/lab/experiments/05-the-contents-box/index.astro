---
import LabLayout from "../../../../layouts/LabLayout.astro";
import Section from "../../../../components/lab/Section.astro";

/**
 * Where a blog post's contents go. Inline at the top, as the design plan
 * started it, a 13-section post puts a 13-line box between the description
 * and the first sentence (#48).
 *
 * One thing moves: where the contents sit. Each candidate is a full page,
 * because the question depends on the window's width and on scrolling, and
 * neither survives being drawn inside this page's column. Each card shows its
 * page live, shrunk, at a desktop and a phone width: an iframe gets its own
 * viewport, so the page's breakpoints fire at the width it is drawn at, and
 * there is no screenshot to fall out of date.
 */

const opened = "2026-10-27";
const settled = "2026-10-27";
const base = "/lab/experiments/05-the-contents-box";

/** The two windows each candidate is drawn in, in CSS pixels. */
const frames = [
  { label: "1440 × 900", width: 1440, height: 900 },
  { label: "390 × 844", width: 390, height: 844 },
];

const record = [
  { label: "Opened", value: opened },
  { label: "Settled", value: settled },
  { label: "Result", value: "F" },
  { label: "Variable", value: "contents placement" },
  { label: "Candidates", value: "6, incl. control" },
  { label: "Breakpoint", value: "1280px (xl)" },
];

const candidates = [
  {
    path: "a-inline",
    name: "A · Inline at the top",
    claim: "The control: the placement before this experiment.",
    note: "A boxed list between the header and the opening. Every reader sees all 13 sections before the first sentence.",
  },
  {
    path: "b-none",
    name: "B · No contents",
    claim: "The box removed at every width.",
    note: "The opening follows the header directly. Sections are found by scrolling; a link to a section still works.",
  },
  {
    path: "c-rail",
    name: "C · Side column",
    claim: "Sticky in the right margin from 1280px, nothing below.",
    note: "The text column stays centred and 68ch wide. The list loses its box, since it no longer has to separate itself from the prose. Below 1280px the page is B.",
  },
  {
    path: "d-rail-and-toggle",
    name: "D · Side column and toggle",
    claim: "C, plus a collapsed toggle at the top below 1280px.",
    note: "Narrow screens keep a way to jump, at the cost of one closed line above the opening.",
  },
  {
    path: "e-subnav-button",
    name: "E · Button in the top bar",
    claim: "“Contents ▾” on the right of the pinned breadcrumb bar.",
    note: "The list opens under the bar and closes on a pick, a click outside or Escape. The bar is pinned, so the list is in reach at every width; on a phone the bar slides away while scrolling down and returns on the way up.",
  },
  {
    path: "f-rail-and-subnav-button",
    name: "F · Side column, then top bar",
    claim: "C from 1280px, E below it.",
    note: "The list stays open beside the text where there is room for it, and folds into the bar's button where there is not.",
  },
];
---

<LabLayout
  title="The contents box"
  intro="A long post's contents sit in a box between its description and its first sentence. Six placements, one of them the box as it is, each on a full page of a test post with 13 sections."
  kind="experiment"
  slug="05-the-contents-box"
>
  <Section
    id="record"
    rule={false}
    title="Record"
    note="Settled. The page is frozen; the losing candidates stay as they were."
  >
    <dl
      class="grid grid-cols-2 grid-ruled overflow-hidden rounded-xl border border-border sm:grid-cols-3"
    >
      {
        record.map((item) => (
          <div class="bg-surface px-4 py-4">
            <dt class="label">{item.label}</dt>
            <dd class="mt-2 font-mono text-sm tracking-tight text-ink">
              {item.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section
    id="hypothesis"
    title="Hypothesis"
    note="Written before looking, so that it can be wrong in public."
  >
    <div class="max-w-measure space-y-4 leading-relaxed text-muted">
      <p>
        Expected: C. On a wide screen the right margin is empty, so the
        contents cost the text nothing there and stay in reach while reading.
        On a phone a 13-line box is the wrong first thing to read, and the post
        is short enough to scroll.
      </p>
      <p>E and F were added after this was written.</p>
    </div>
  </Section>

  <Section
    id="candidates"
    rule={false}
    title="Candidates"
    note="Each preview is the live page; scroll inside it. Open one for the full window, then narrow it below 1280px and to a phone's width."
  >
    <div class="space-y-6">
      {
        candidates.map((candidate) => (
          <article class="overflow-hidden rounded-xl border border-border bg-surface">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-border px-5 py-3">
              <h3 class="label !text-ink">{candidate.name}</h3>
              <p class="font-mono text-xs tracking-tight text-dim">
                {candidate.claim}
              </p>
            </div>

            <div class="previews flex flex-col gap-4 bg-bg p-4 sm:flex-row sm:p-6">
              {frames.map((frame) => (
                <figure style={`--ratio: ${frame.width / frame.height}`}>
                  <div
                    class="preview relative overflow-hidden rounded-lg border border-border"
                    style={`aspect-ratio: ${frame.width} / ${frame.height}`}
                    data-preview
                  >
                    <iframe
                      src={`${base}/${candidate.path}`}
                      title={`${candidate.name} at ${frame.label}`}
                      width={frame.width}
                      height={frame.height}
                      loading="lazy"
                      tabindex="-1"
                    />
                  </div>
                  <figcaption class="mt-2 font-mono text-xs tracking-tight text-dim">
                    {frame.label}
                  </figcaption>
                </figure>
              ))}
            </div>

            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 border-t border-border px-5 py-4">
              <p class="max-w-measure text-sm leading-relaxed text-muted">
                {candidate.note}
              </p>
              <a
                href={`${base}/${candidate.path}`}
                class="label transition-colors duration-150 hover:!text-label-hover"
              >
                Open →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="result" title="Result" note="Filled in by looking.">
    <p class="max-w-measure leading-relaxed text-muted">
      <strong class="font-semibold text-ink">F</strong>, settled {settled}. C's
      side column from 1280px, and E's button in the pinned bar below that.
    </p>
  </Section>
</LabLayout>

<script>
  // Each iframe is drawn at its real window size and scaled down to its box.
  // CSS cannot divide one length by another to get the factor, so it is
  // measured here and kept in step as the box resizes.
  const observer = new ResizeObserver((entries) => {
    for (const { target } of entries) {
      const frame = target.querySelector("iframe");
      if (!frame) continue;
      // offsetWidth is the layout width, which the transform leaves alone.
      const scale = target.clientWidth / frame.offsetWidth;
      frame.style.transform = `scale(${scale})`;
    }
  });
  document
    .querySelectorAll<HTMLElement>("[data-preview]")
    .forEach((preview) => observer.observe(preview));
</script>

<style>
  .preview {
    max-width: 100%;
  }

  /* On a phone the two previews stack; the phone one would otherwise fill
     the screen's width and be taller than the screen. */
  figure:last-child .preview {
    width: 12rem;
    margin-inline: auto;
  }

  /* Side by side, each preview grows by its window's width-to-height ratio
     from a zero base, so both come out the same height. */
  @media (width >= 40rem) {
    .previews figure {
      flex: var(--ratio) 1 0;
      min-width: 0;
    }

    figure:last-child .preview {
      width: auto;
    }
  }

  .preview iframe {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    border: 0;
  }
</style>
