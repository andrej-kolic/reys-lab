---
import { Font } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import LabControls from "../components/lab/LabControls.astro";

interface Props {
  title: string;
  /** Mono eyebrow above the page heading. */
  eyebrow: string;
  intro: string;
}

const { title, eyebrow, intro } = Astro.props;

const sections = [
  { href: "/lab", label: "Index" },
  { href: "/lab/type", label: "Type" },
  { href: "/lab/colour", label: "Colour" },
  { href: "/lab/components", label: "Components" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/lab";
---

<BaseLayout title={`${title} · Rey's Lab`} noindex>
  <Fragment slot="head">
    {/* Blocking, before first paint: restoring a saved candidate after paint
        would flash the wrong palette. Same reason dark mode cannot be an
        island — see the design plan. */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var defaults = {
          theme: "violet",
          shade: "a",
        };
        // Locked, so it is set rather than restored — a browser that stored a
        // losing value back when glow had a control would otherwise be stuck
        // on it with no way left to change it.
        d.setAttribute("data-glow", "0.28");
        for (var key in defaults) {
          var saved = null;
          try {
            saved = localStorage.getItem("lab:" + key);
          } catch (e) {
            /* private browsing */
          }
          d.setAttribute("data-" + key, saved || defaults[key]);
        }
      })();
    </script>
  </Fragment>

  <LabControls />

  <div class="mx-auto max-w-5xl px-5 pb-24">
    <nav class="flex flex-wrap gap-x-5 gap-y-2 py-5" aria-label="Lab sections">
      {
        sections.map((section) => (
          <a
            href={section.href}
            aria-current={section.href === path ? "page" : undefined}
            class="label transition-colors duration-150 hover:!text-ink aria-[current=page]:!text-warm"
          >
            {section.label}
          </a>
        ))
      }
    </nav>

    <header class="glow border-b border-border pt-10 pb-12">
      <p class="label !text-accent">{eyebrow}</p>
      <h1
        class="mt-3 font-display text-5xl leading-[1.05] font-bold tracking-tight text-balance sm:text-6xl"
      >
        {title}
      </h1>
      <p class="mt-5 max-w-measure text-lg leading-relaxed text-muted text-pretty">
        {intro}
      </p>
    </header>

    <main class="pt-14">
      <slot />
    </main>

    <footer class="mt-24 border-t border-border pt-6">
      <p class="label">
        Not linked from site navigation · noindex · kept after launch as the
        living style reference
      </p>
    </footer>
  </div>
</BaseLayout>
