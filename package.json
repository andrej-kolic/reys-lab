{
  "name": "reys-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "gate": "turbo run gate",
    "dev": "turbo run dev",
    "preview": "turbo run preview --filter=@reys-lab/web",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "deploy": "turbo run deploy",
    "versions": "node scripts/versions.js",
    "rules:fetch": "rulesync fetch andrej-kolic/playbook -f rules -t rulesync -p .rulesync",
    "rules:generate": "rulesync generate -f rules -t claudecode,cursor",
    "rules:install": "pnpm run rules:fetch && pnpm run rules:generate"
  },
  "devDependencies": {
    "rulesync": "16.24.1",
    "turbo": "catalog:"
  }
}
