---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { forProject, href as experimentHref } from "../../lib/experiments";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);

// The project↔experiment relation. Experiments live at one canonical URL
// under /lab and are selected here rather than nested — nesting would either
// duplicate each page at two addresses or break the global sequence.
const experiments = forProject(project.id);

const { links, logoFit } = project.data;
---

<SiteLayout
  title={project.data.title}
  description={project.data.description}
  width="measure"
  shareImage={project.data.shareImage}
>
  <Breadcrumb
    slot="subnav"
    trail={[{ href: "/projects", label: "Projects" }]}
    current={project.data.title}
  />

  <header class="border-b border-frame pb-8">
    <p class="label !text-accent">{project.data.status}</p>
    <h1
      class="mt-3 font-display text-4xl leading-[1.1] font-bold tracking-tight text-balance sm:text-5xl"
    >
      {
        project.data.logo && (
          // Plain <img>: an SVG has nothing to optimise, and <Image> needs
          // sharp. Empty alt, since the heading names the project.
          <img
            src={project.data.logo.src}
            width={project.data.logo.width}
            height={project.data.logo.height}
            alt=""
            class="title-logo"
            style={
              logoFit && {
                "--logo-height": `${logoFit.height}em`,
                "--logo-drop": `${logoFit.drop}em`,
              }
            }
          />
        )
      }
      {project.data.title}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted text-pretty">
      {project.data.description}
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-2">
      {
        project.data.stack.map((item) => (
          <span class="tag">
            {item}
          </span>
        ))
      }
    </div>
  </header>

  <article class="prose pt-10">
    <Content />
  </article>

  {
    experiments.length > 0 && (
      <section class="mt-14 border-t border-divider pt-8">
        <h2 class="font-display text-xl font-semibold tracking-tight">
          Experiments run for this
        </h2>
        <ul class="mt-4 space-y-2">
          {experiments.map((experiment) => (
            <li>
              <a
                href={experimentHref(experiment)}
                class="flex flex-wrap items-baseline gap-x-3 text-accent underline decoration-accent/40 underline-offset-4 transition-colors duration-150 hover:decoration-accent"
              >
                <span class="label !text-dim">
                  Experiment {experiment.number}
                </span>
                {experiment.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    links.length > 0 && (
      <section class="mt-14 border-t border-divider pt-8">
        <div class="flex flex-wrap gap-x-5 gap-y-3">
          {links.map((link) => (
            <a
              href={link.url}
              class="btn-secondary"
            >
              {link.label}
            </a>
          ))}
        </div>
      </section>
    )
  }
</SiteLayout>

<style>
  /* Beside the title, as tall as a flat capital in Outfit Bold (0.706em) and
     sitting on the baseline. A project whose first letter is round sets
     `logoFit` to match it instead. Placement: design plan, Project pages. */
  .title-logo {
    display: inline-block;
    height: var(--logo-height, 0.706em);
    width: auto;
    vertical-align: calc(-1 * var(--logo-drop, 0em));
    margin-right: 0.3em;
  }
</style>
