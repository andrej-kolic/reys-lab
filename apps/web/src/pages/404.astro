---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found" noindex width="measure">
  <p class="label !text-accent">404</p>
  <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-balance">
    Nothing at this address
  </h1>
  <p class="mt-6 text-lg leading-relaxed text-muted text-pretty">
    The page you're looking for doesn't exist, or moved.
  </p>
  <a href="/" class="btn-primary mt-8 inline-block">Back to the lab</a>
</SiteLayout>
